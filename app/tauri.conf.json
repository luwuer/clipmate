{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipMate",
  "version": "0.2.0",
  "identifier": "com.mdy.clipmate",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipMate",
        "width": 720,
        "height": 540,
        "minWidth": 560,
        "minHeight": 240,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
